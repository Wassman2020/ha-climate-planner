{
  "config": {
    "step": {
      "user": {
        "title": "Climate Planner",
        "description": "Adds season-aware weekly schedules. Schedules are edited from the “Climate” side panel."
      }
    },
    "abort": {
      "single_instance_allowed": "Already configured."
    }
  },
  "entity": {
    "select": {
      "season": {
        "name": "Season",
        "state": {
          "winter": "Winter",
          "transition": "Mid-season",
          "summer": "Summer"
        }
      }
    },
    "switch": {
      "enabled": {
        "name": "Scheduling enabled"
      },
      "auto_season": {
        "name": "Date-based season change"
      }
    }
  },
  "selector": {
    "season": {
      "options": {
        "winter": "Winter",
        "transition": "Mid-season",
        "summer": "Summer"
      }
    }
  },
  "services": {
    "resync": {
      "name": "Resync",
      "description": "Apply the state each active schedule expects right now."
    },
    "set_season": {
      "name": "Set season",
      "description": "Change the active season.",
      "fields": {
        "season": {
          "name": "Season",
          "description": "Season to activate."
        }
      }
    },
    "save_schedule": {
      "name": "Save schedule",
      "description": "Create or replace a schedule (same id = replace). Days: 0 = Monday … 6 = Sunday. A slot without 'end' is a point action.",
      "fields": {
        "id": {
          "name": "ID",
          "description": "Identifier; replaced if it exists."
        },
        "name": {
          "name": "Name",
          "description": "Display name."
        },
        "seasons": {
          "name": "Seasons",
          "description": "Seasons in which it runs."
        },
        "entities": {
          "name": "Devices",
          "description": "Climate entities."
        },
        "enabled": {
          "name": "Enabled",
          "description": "Whether the schedule is enabled."
        },
        "off_outside": {
          "name": "Off at end",
          "description": "Turn off when each slot ends."
        },
        "slots": {
          "name": "Slots",
          "description": "List of slots."
        }
      }
    },
    "delete_schedule": {
      "name": "Delete schedule",
      "description": "Delete a schedule.",
      "fields": {
        "schedule_id": {
          "name": "ID",
          "description": "Schedule ID."
        }
      }
    },
    "list_schedules": {
      "name": "List schedules",
      "description": "Return the full configuration."
    }
  }
}